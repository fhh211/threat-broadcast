#!/usr/bin/env python
# -*- coding: utf-8 -*-
# -----------------------------------------------
# Apache Struts2 安全公告：https://struts.apache.org/security/
# 年度公告页：https://struts.apache.org/announce-YYYY.html
# -----------------------------------------------

import re
import datetime
import requests
from lxml import etree
from src.bean.cve_info import CVEInfo
from src.crawler._base_crawler import BaseCrawler
from color_log.clog import log


class Struts2(BaseCrawler):

    def __init__(self):
        BaseCrawler.__init__(self)
        self.name_ch = 'Apache Struts2 安全公告'
        self.name_en = 'Apache Struts2'
        self.home_page = 'https://struts.apache.org/security/'
        # 当年 + 去年公告页，覆盖跨年未归档条目
        year = datetime.datetime.now().year
        self.url_list = [
            'https://struts.apache.org/announce-%d.html' % year,
            'https://struts.apache.org/announce-%d.html' % (year - 1),
        ]
        self.url_base = 'https://struts.apache.org/'


    def NAME_CH(self):
        return self.name_ch


    def NAME_EN(self):
        return self.name_en


    def HOME_PAGE(self):
        return self.home_page


    def get_cves(self, limit = 10):
        cves = []
        for url in self.url_list:
            response = requests.get(url, headers=self.headers(), timeout=self.timeout)
            if response.status_code != 200:
                log.warn('获取 [%s] 公告页失败： [HTTP Error %i] %s' % (
                    self.NAME_CH(), response.status_code, url))
                continue
            try:
                doc = etree.HTML(response.content)
            except Exception as exc:
                log.warn('解析 [%s] 公告页失败： %s' % (self.NAME_CH(), exc))
                continue

            # 公告标题为 h4，形如 "5 October 2026 - CVE-2026-104711: xxxx"
            for h4 in doc.xpath('//h4'):
                text = ' '.join(''.join(h4.itertext()).split())
                if not re.search(r'CVE-\d+-\d+', text):
                    continue  # 跳过 "Struts 7.4.0 GA" 等非漏洞公告
                cve = self.to_cve(text, h4)
                if cve.is_vaild() and cve.MD5() not in [c.MD5() for c in cves]:
                    cves.append(cve)

        # 按披露时间倒序，取最新
        cves.sort(key=lambda c: c.time, reverse=True)
        return cves[:limit]


    def to_cve(self, text, node):
        cve = CVEInfo()
        cve.src = self.NAME_CH()
        cve.info = text

        rst = re.findall(r'(CVE-\d+-\d+)', text)
        cve.id = rst[0] if rst else ''

        # 解析日期前缀，如 "5 October 2026 - ..."
        m = re.match(r'(\d{1,2}\s+\w+\s+\d{4})\s*[-–]', text)
        if m:
            cve.time = m.group(1)
        else:
            cve.time = ''

        cve.title = re.sub(r'^\d{1,2}\s+\w+\s+\d{4}\s*[-–]\s*', '', text).strip()

        # 优先用公告自身的锚点 id（形如 a20261005-s2075）
        anchor = node.get('id') or ''
        if anchor:
            cve.url = '%s#%s' % (self.url_list[0], anchor)
        else:
            cve.url = self.home_page
        return cve
